# Agent key from https://bitgn.com/me/agents (its MCP URL is https://brain.bitgn.com/mcp/<key>)
BRAIN_AGENT_KEY=
# Name the agent signs its workspace posts with
BRAIN_AGENT_NAME=msh-agent
# Any pydantic-ai model string; zai: goes to the coding-plan endpoint (ZAI_BASE_URL overrides)
BRAIN_MODEL=zai:glm-5.3-flash
ZAI_API_KEY=
# Gates (1 = enabled). Sandbox runs use the shared ECOM1 queue -- keep off unless agreed.
BRAIN_ALLOW_COMMIT=0
BRAIN_ALLOW_SANDBOX=0
BRAIN_RUN_BUDGET_USD=3
# Loop commits are reviewed by this model against the server's diff (empty = no review)
BRAIN_COMMIT_JUDGE_MODEL=zai:glm-5.3
# Loop ticks are reviewed mid-run by this model every 6 requests (empty = no review)
BRAIN_TRAJECTORY_JUDGE_MODEL=zai:glm-5.3
# Sandbox queue rules (sandbox_guard.py): smoke = trials <= SMOKE_MAX; full runs only
# when the queue is <= FULL_DEPTH_MAX deep; nothing above HARD_DEPTH_MAX. 1 submit/tick.
# Optional: Logfire write token (traces are sent only when set) and the eval judge model
LOGFIRE_TOKEN=
BRAIN_JUDGE_MODEL=zai:glm-5.3
BRAIN_SANDBOX_SMOKE_MAX=10
BRAIN_SANDBOX_FULL_DEPTH_MAX=10
BRAIN_SANDBOX_HARD_DEPTH_MAX=35
